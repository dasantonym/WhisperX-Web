# CUDA image: CUDA 12.6 + cuDNN 9 runtime (required by ctranslate2 on GPU),
# ffmpeg (required by whisperx.load_audio), and CUDA torch wheels.
FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# libpython3.10: torchcodec (pyannote.audio's audio decoder) ships one native
# build per FFmpeg major version; against Ubuntu 22.04's FFmpeg 4.4 only the
# FFmpeg 4 variant can load, and that variant is linked against
# libpython3.10.so.1.0, which Ubuntu's python3.10 package does not provide.
# Without it, pyannote warns on every startup that torchcodec is broken.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg python3 python3-pip libpython3.10 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md ./
COPY whisperx_web ./whisperx_web

# whisperx pins torch~=2.8.0 / torchvision~=0.23.0; install the CUDA 12.6
# wheels up front so the later `pip install .` keeps them. cuDNN 9 comes from
# the base image (required by ctranslate2 on GPU).
#
# WHISPERX_VERSION: see Dockerfile.cpu — canary builds pass the newest PyPI
# release here to test the latest WhisperX against this image recipe.
#
# Ubuntu 22.04's system pip (22.0.2, Debian-patched) checks build-system
# requirements only by distribution name and ignores version constraints, so
# it would use the system setuptools (< 61, no PEP 621 support) and silently
# build an empty UNKNOWN-0.0.0 package without the `whisperx-web` console
# script. Upgrade pip first so the [build-system] table in pyproject.toml is
# honored.
ARG WHISPERX_VERSION=
RUN python3 -m pip install --no-cache-dir --upgrade pip \
    && python3 -m pip install --no-cache-dir \
        'torch~=2.8.0' 'torchaudio~=2.8.0' 'torchvision~=0.23.0' \
        --index-url https://download.pytorch.org/whl/cu126 \
    && if [ -n "$WHISPERX_VERSION" ]; then \
        sed -i "s/^    \"whisperx[^\"]*\",$/    \"whisperx==$WHISPERX_VERSION\",/" pyproject.toml \
        && grep -q "^    \"whisperx==$WHISPERX_VERSION\",$" pyproject.toml \
        || { echo "Failed to override whisperx pin to $WHISPERX_VERSION" >&2; exit 1; } \
    fi \
    && python3 -m pip install --no-cache-dir .

ENV WHISPERX_HOST=0.0.0.0 \
    WHISPERX_PORT=8000

EXPOSE 8000

CMD ["whisperx-web"]
